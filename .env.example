# Environment variables — copy to `.env.local`. Never commit real keys.

# Shared secret required by /api/openai/* and /api/anthropic/chat
# Send as header: x-api-secret: <value>  or  Authorization: Bearer <value>
API_SECRET=

# Server-only model keys (do not prefix with NEXT_PUBLIC_)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPGRAM_API_KEY=

# Google Maps JavaScript API (browser). Restrict this key by HTTP referrer
# in Google Cloud Console. Do not use an unrestricted key.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
