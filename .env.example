# Copy to .env.local and fill in locally. Never commit real values.

# Required for the Maps demo (browser). Restrict this key by HTTP referrer in GCP.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Shared secret for server AI/proxy routes. Send as header: x-api-secret: <value>
# Do not prefix with NEXT_PUBLIC_ — that would embed the secret in the client bundle.
API_ROUTE_SECRET=

# Provider keys — server only. Never expose to the client.
DEEPGRAM_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
REPLICATE_API_TOKEN=

# Optional: allow signed-in Firebase users to call protected /api/* routes.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
